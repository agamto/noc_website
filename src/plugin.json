{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Noc_app",
  "id": "main-noc-app",
  "backend": true,
  "executable": "gpx_noc_app",
  "info": {
    "keywords": ["app"],
    "description": "",
    "author": {
      "name": "Main"
    },
    "logos": {
      "small": "img/logo.png",
      "large": "img/logo.png"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "main page",
      "path": "/a/%PLUGIN_ID%/main",
      "role": "Admin",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "name": "contacts",
      "path": "/a/%PLUGIN_ID%/contacts",
      "role": "Admin",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "docs",
      "path": "/a/%PLUGIN_ID%/docs",
      "role": "Admin",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "dashboards",
      "path": "/a/%PLUGIN_ID%/dashboards",
      "role": "Admin",
      "addToNav": true,
      "defaultNav": false
    },
    {
      "type": "page",
      "name": "docs editor",
      "path": "/a/%PLUGIN_ID%/docs/:name",
      "role": "Admin",
      "addToNav": false,
      "defaultNav": false
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.4.0",
    "plugins": []
  }
}
